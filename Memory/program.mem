06300e93  // 120: addi x29,x0,99   | S5 SHOULD BE FLUSHED (branch taken skips this)
00800f6f  // 124: jal  x30,+8      | S5 branch target; jump ahead, link x30
05800f93  // 128: addi x31,x0,88   | S5 SHOULD BE FLUSHED (jal skips this)
03700093  // 132: addi x1,x0,55    | S5 jal target lands here, x1=55
04200113  // 136: addi x2,x0,66    | S5 filler
01e00293  // 140: addi x5,x0,30    | S6 x5=30 (reused reg)
00629663  // 144: bne  x5,x6,+12   | S6 x5(30)!=x6(1) -> branch TAKEN -> flush next 2 instrs
06f00313  // 148: addi x6,x0,111   | S6 SHOULD BE FLUSHED
006303b3  // 152: add  x7,x6,x6    | S6 SHOULD BE FLUSHED (also has hazard on x6 if not flushed)
0de00413  // 156: addi x8,x0,222   | S6 branch target lands here, x8=222
008404b3  // 160: add  x9,x8,x8    | S6 EX/MEM FORWARD: x8 used immediately after target
00500513  // 164: addi x10,x0,5    | S6 filler
00208033  // 168: add  x0,x1,x2    | S7 attempted write to x0 -> must stay 0
003005b3  // 172: add  x11,x0,x3   | S7 use x0 immediately -> must read 0, not forwarded
03200013  // 176: addi x0,x0,50    | S7 attempted write to x0 -> must stay 0
40400633  // 180: sub  x12,x0,x4   | S7 use x0 immediately -> must read 0
00000693  // 184: addi x13,x0,0    | S7 baseline x0 source use
00000733  // 188: add  x14,x0,x0   | S7 x14=0
