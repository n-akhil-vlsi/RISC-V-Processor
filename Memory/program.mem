010788b3  // 64:  add  x17,x15,x16 | S3 MEM/WB fwd x15(2back)+EX/MEM fwd x16(1back)
00b00913  // 68:  addi x18,x0,11   | S3 filler
00c00993  // 72:  addi x19,x0,12   | S3 filler
00d00a13  // 76:  addi x20,x0,13   | S3 filler
00e00a93  // 80:  addi x21,x0,14   | S3 filler
00202223  // 84:  sw   x2,4(x0)    | S4 store x2(10) to mem[1]
00402b03  // 88:  lw   x22,4(x0)   | S4 load into x22
003b0bb3  // 92:  add  x23,x22,x3  | S4 LOAD-USE HAZARD -> stall
416b8c33  // 96:  sub  x24,x23,x22 | S4 EX/MEM fwd x23 + MEM/WB fwd x22
00f00c93  // 100: addi x25,x0,15   | S4 filler
01000d13  // 104: addi x26,x0,16   | S4 filler
